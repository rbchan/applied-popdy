# Background



[]
  ## Learning objectives
  \Large
  The equation for logistic growth in discrete time \\
  
  
  The definition of density-dependent growth \\
  
  
  Basic properties of the model \\
  
  
  Strange behavior of the (discrete time) model, such as damped oscillations and chaos \\




# Logistic growth



  ## From Geometric to Logistic Growth
  \large
  {\bf Geometric growth}
  \[]
  
  {\bf Logistic growth}
  \[]
  where \\
  
    * $r_{max}$ is the growth rate when $N_t$ is close to 0. \\
    * $K$ is the carrying capacity
  







  ## Density-dependent growth
  \large
  Logistic growth is an example of {\bf density-dependent
    growth} \\
  
  \visible<2->{** Definition: ** Population growth rate %($\lambda$)
    {\it is}  affected by population size ($N$).} \\
  
  \visible<3->{** Implications **:  Resources are limited and there
    is a carrying capacity.} \\





[]
  ## Graphical depiction
```{r, geomVlogistic,echo=FALSE}
#Year <- 2000:3000
Time <- 0:100
T <- length(Time)
rmax <- .1
K <- 50
Ng <- Nl <- rep(0, T)
Ng[] <- Nl[] <- 2
for(t in 2:T) {
    Ng[] <- Ng[] + Ng[]*rmax
    Nl[] <- Nl[] + Nl[]*rmax*(1 - Nl[]/K)
}
@
```{r, geom,include=FALSE,echo=FALSE}
plot(Time, Ng, lwd=5, type="l", ylim=c(0, 100), cex.lab=1.5,
     xlab="Time (t)", ylab="Population size (N)")
legend(50, 100, c("Geometric growth", ""), lty=1, col=c("black", NA), lwd=4)
@

```{r, geom-logistic,include=FALSE,echo=FALSE}
plot(Time, Ng, lwd=5, type="l", ylim=c(0, 100), cex.lab=1.5,
     xlab="Time (t)", ylab="Population size (N)")
lines(Time, Nl, lwd=4, col="purple")
legend(50, 100, c("Geometric growth", "Logistic growth"), lty=1,
       col=c("black","purple"), lwd=4)
@

<center>
  \only<1 | handout:0>{![](figure/geom-1})
  \only<2>{![](figure/geom-logistic-1})
</center>









[]
  ## Growth rate ($\lambda_t = N_{t+1/N_t$)}
```{r, lr1,include=FALSE,echo=FALSE,fig.width=12,fig.height=4}
par(mai=c(0.9,1,0.3,0.3))
plot(Time, Nl, lwd=4, type="l", ylim=c(0, 60), cex.lab=1.9,
     xlab="Time (t)", ylab="Population size (N)", col="purple")
points(Time[], Nl[],
       pch=16, cex=5, col="orange")
text(Time[]+5, Nl[],
     labels="Inflection point (K/2)", pos=4, cex=1.5)
@
```{r, lambda,include=FALSE,echo=FALSE,fig.width=12,fig.height=4}
lambda <- Nl[]/Nl[]
par(mai=c(0.9,1,0.3,0.3))
plot(Time[], lambda, lwd=4, type="l", cex.lab=1.9,
     xlab="Time (t)", col="blue",
     ylab=expression(paste("Growth rate: ", "(", lambda, "=", N[]/N[], ")")))
@
<center>
  ![](figure/lr1-1) \\ 
  ![](figure/lambda-1)
</center>








[]
  ## Growth ($\Delta_t=N_{t+1-N_t$)}
```{r, lr2,include=FALSE,echo=FALSE,fig.width=12,fig.height=4}
par(mai=c(0.9,1,0.3,0.3))
plot(Time, Nl, lwd=4, type="l", ylim=c(0, 60), cex.lab=1.9,
     xlab="Time (t)", ylab="Population size (N)", col="purple")
points(Time[], Nl[],
       pch=16, cex=5, col="orange")
text(Time[]+5, Nl[],
     labels="Inflection point (K/2)", pos=4, cex=1.5)
@
```{r, delta,include=FALSE,echo=FALSE,fig.width=12,fig.height=4}
delta <- Nl[] - Nl[]
par(mai=c(0.9,1,0.3,0.3))
plot(Time[], delta, lwd=4, type="l", cex.lab=1.9,
     xlab="Time (t)", col="turquoise4",
     ylab=expression(paste("Growth: ", "(", Delta, "=", N[]-N[], ")")))
@
<center>
  ![](figure/lr2-1) \\ 
  ![](figure/delta-1)
</center>




[]
  ## Growth ($\Delta_t=N_{t+1-N_t$) as a function of $N$}
```{r, delta-N,include=FALSE,echo=FALSE,fig.width=8,fig.height=6}
plot(Nl[], delta, lwd=4, type="l", cex.lab=1.2,
     xlab="Population size (N)",
     ylab=expression(paste("Growth: ", "(", Delta, "=", N[]-N[], ")")))
abline(h=0, col="gray")
abline(v=K/2, lty=3, lwd=2)
text(K/2, 0.05, "Inflection point (K/2)", pos=4)
@
<center>
  ![](figure/delta-N-1)
</center>







[]
  ## What happens when we change $r_{max$?}
```{r, echo=FALSE}
Nl4 <- Nl3 <- Nl2 <- Nl
Nl4[] <- Nl3[] <- Nl2[] <- 2
for(t in 2:T) {
    Nl2[] <- Nl2[] + Nl2[]*0.5*(1-Nl2[]/K)
    Nl3[] <- Nl3[] + Nl3[]*2.0*(1-Nl3[]/K)
    Nl4[] <- Nl4[] + Nl4[]*3.0*(1-Nl4[]/K)
}
@
```{r, Nl,include=FALSE,echo=FALSE,fig.width=8,fig.height=6}
plot(Time, Nl, lwd=4, type="l", ylim=c(0, 100), cex.lab=1.3,
     xlab="Time (t)", ylab="Population size (N)", col="purple")
legend(0, 100, c("rmax=0.1", "", "", ""),
       lwd=4, col=c("purple", NA, NA, NA))
@
```{r, Nl2,include=FALSE,echo=FALSE,fig.width=8,fig.height=6}
plot(Time, Nl, lwd=4, type="l", ylim=c(0, 100), cex.lab=1.3,
     xlab="Time (t)", ylab="Population size (N)", col="purple")
lines(Time, Nl2, lwd=4, col="blue")
legend(0, 100, c("rmax=0.1", "rmax=0.5", "", ""),
       lwd=4, col=c("purple", "blue", NA, NA))
@
```{r, Nl3,include=FALSE,echo=FALSE,fig.width=8,fig.height=6}
plot(Time, Nl, lwd=4, type="l", ylim=c(0, 100), cex.lab=1.3,
     xlab="Time (t)", ylab="Population size (N)", col="purple",
     main="Damped oscillation")
lines(Time, Nl2, lwd=4, col="blue")
lines(Time, Nl3, lwd=4, col="orange")
legend(0, 100, c("rmax=0.1", "rmax=0.5", "rmax=2.0", ""),
       lwd=4, col=c("purple", "blue", "orange", NA))
@
```{r, Nl4,include=FALSE,echo=FALSE,fig.width=8,fig.height=6}
plot(Time, Nl, lwd=4, type="l", ylim=c(0, 100), cex.lab=1.3,
     xlab="Time (t)", ylab="Population size (N)", col="purple",
     main="Chaos")
lines(Time, Nl2, lwd=4, col="blue")
lines(Time, Nl3, lwd=4, col="orange")
lines(Time, Nl4, lwd=4, col="gray")
legend(0, 100, c("rmax=0.1", "rmax=0.5", "rmax=2.0", "rmax=3.0"),
       lwd=4, col=c("purple", "blue", "orange", "gray"))
@
