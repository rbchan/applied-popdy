  ## Harvest and logistic growth
  \LARGE
  \[]
  
%  
  
  
  \centering %\bf
  What value of $H_t$ achieves equilibrium? \\





  ## Sustainable harvest and logistic growth
  \LARGE
  \[]
  
  
  
%  \bf
  In this case, the sustainable harvest rate ($h$) depends on population size
  
  
  % \[]
  \begin{align*}
    h_t &= \frac{H_t}{N_t} \\
    \uncover<4->{h_t &= r_{max}\left(1 - \frac{N_t}{K} \right)} \\
  \end{align*}




[]
  ## Example when $K=1000$ and $r_{max=0.1$}
  \scriptsize
  \[]
  
%```{r, msy1,fig=TRUE,include=FALSE,fig.width=12,fig.height=6,echo=FALSE}
```{r, msy1,include=FALSE,echo=FALSE}
N <- seq(0, 1000, by=10)
rmax <- 0.1
K <- 1000
H.1 <- N*rmax*(1 - N/K)
#par(mfrow=c(1,2), mai=c(0.7, 0.7, 0.2, 0.2))
#plot(0:T, Nl, xlab="Time", ylab="Population size (N)")
plot(N, H.1, type="l", #asp=1,
     col="black", lwd=2,
     cex.lab=1.4,
     xlab="Population size (N)",
     ylab="Sustainable harvest (H)")
abline(h=0, col=gray(0.7))
segments(K/2, 0, K/2, max(H.1), lty=2, lwd=2, col="purple")
@
  <center>
%  ![](harvest-msy1)
  ![](figure/msy1-1)
  </center>





